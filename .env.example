# Local bun dev: localhost. docker compose overrides this to mongodb:27017 for the app service.
DATABASE_URI=mongodb://127.0.0.1/trt-newsroom-ai
PAYLOAD_SECRET=

GOOGLE_GENERATIVE_AI_API_KEY=

EVENT_REGISTRY_API_KEY=

CMS_BASE_URL=https://cms.trt-global.example
CMS_API_KEY=
# Set CMS_STUB=1 to force local stubs even with a real-looking CMS_BASE_URL.
# Placeholder/example URLs already stub automatically (channel seed, empty search, fake publish).
# CMS_STUB=1

# Required to install/update payload-richtext-tiptap (same TipTap editor as cms-prod).
# Get a token from TipTap Pro; .npmrc reads ${TIPTAP_AUTH_TOKEN}.
# TIPTAP_AUTH_TOKEN=
